{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  // Mirrors tsconfig.web.json purely so the shadcn CLI can resolve import
  // aliases; without it, `shadcn init` fails with "No import alias found".
  // Compile-inert: `files: []` means this config builds nothing, and neither
  // referenced project extends it (tsconfig.web.json extends
  // @electron-toolkit/tsconfig/tsconfig.web.json).
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
